{
  "name": "yukino-motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5197 --strictPort",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:desktop": "node scripts/desktop-qa.mjs",
    "verify:assets": "node scripts/audit-assets.mjs --verify",
    "build": "npm run typecheck && vite build",
    "build:desktop": "npm run build && node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "playwright-core": "1.64.1",
    "rcedit": "4.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "8.3.5"
  }
}
