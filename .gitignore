/public/characters/*.glb
# The qipao export fix is a small, reviewed runtime repair referenced by the
# catalog; keep this one versioned so a release can reproduce the continuous
# waist without re-exporting the approved Blender final.
!/public/characters/05-qipao-v2-fixed.glb
/resources/character-source/*.glb.gz
/review-assets/*.glb

# Reconstructed byte-for-byte from the pinned wallpaper transport parts.
/public/wallpapers/yukino-sky-01.png
/public/wallpapers/yukino-sky-02.png

# Official website icons are fetched and recorded as build artifacts.
/public/provider-logos/

