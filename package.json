{
  "name": "yukino-companion",
  "version": "0.4.0",
  "description": "Yukino Companion · 双语数字角色与桌面陪伴",
  "author": "fqxxzyw",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run prepare:companions && vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "test": "node --test tests/*.test.cjs",
    "prepare:inference": "python scripts/build_windows_runtime.py --source-only",
    "runtime:cpu": "python scripts/build_windows_runtime.py --flavor cpu",
    "runtime:cuda": "python scripts/build_windows_runtime.py --flavor cu124",
    "verify:characters": "node scripts/verify-character-package.cjs",
    "prepare:companions": "node scripts/prepare-companion-assets.cjs",
    "prepare:translation": "python translation/prepare.py",
    "verify:offline": "node scripts/verify-offline-package.cjs",
    "qa:ui": "electron scripts/capture-ui.cjs --output build/ui-review",
    "package:payload": "python scripts/package-app-payload.py",
    "package:bootstrap": "node scripts/build-bootstrap.cjs",
    "package:runtime": "python scripts/package-runtime.py",
    "prepare:local-model": "python scripts/prepare-local-model.py",
    "prepare:voice": "python scripts/prepare-bundled-voice.py",
    "qa:pet": "electron scripts/capture-pet-ui.cjs --output build/pet-ui-review"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "io.github.fqxxzyw.yukino",
    "productName": "Yukino Companion",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "resources/voice-models.json",
      "characters/**/*",
      "resources/translation-models.json",
      "translation/model-manifest.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Yukino-Companion-${version}-Setup.exe",
      "signAndEditExecutable": true,
      "icon": "branding/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "branding/app-icon.ico",
      "uninstallerIcon": "branding/app-icon.ico",
      "installerHeaderIcon": "branding/app-icon.ico",
      "shortcutName": "Yukino Companion",
      "unicode": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    },
    "extraResources": [
      {
        "from": "inference",
        "to": "inference",
        "filter": [
          "*.py",
          "requirements.txt"
        ]
      },
      {
        "from": "translation",
        "to": "translation",
        "filter": [
          "*.py",
          "*.json",
          "*.txt",
          "NOTICE.md",
          "README.md"
        ]
      },
      {
        "from": "translation/models/hy-mt2-1.8b-q4",
        "to": "translation-models/hy-mt2-1.8b-q4",
        "filter": [
          "*.gguf",
          "*.md",
          "*.txt"
        ]
      },
      {
        "from": "build/runtime-distribution/runtime-catalog.json",
        "to": "runtime-catalog.json"
      },
      {
        "from": "resources/local-model/yukino-1.5b-persona-q4",
        "to": "local-model/yukino-1.5b-persona-q4"
      },
      {
        "from": "model-service/desktop_worker.py",
        "to": "local-chat/desktop_worker.py"
      },
      {
        "from": "build/bundled-voice",
        "to": "voice-models",
        "filter": [
          "**/*",
          "!**/*.zip",
          "!**/*.part"
        ]
      }
    ]
  }
}
